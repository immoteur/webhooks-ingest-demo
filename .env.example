# Used by `pnpm dev` / `pnpm db:migrate` (host → Postgres in Docker)
DATABASE_URL=postgresql://api_writer:DemoApiWriter!2025ChangeMe@localhost:15432/webhooks_ingest
PORT=3000
LOG_LEVEL=info
WEBHOOK_ALLOWED_IP=
CLASSIFIEDS_EXPORT_STORAGE_MODE=persist
WEBHOOK_EVENTS_RETENTION_HOURS=24
WEBHOOK_EVENTS_MAX_ROWS=0
WEBHOOK_PAYLOAD_RETENTION_MAX_BYTES=8589934592
CLASSIFIEDS_LAST_SEEN_RETENTION_DAYS=7
CLASSIFIEDS_MAX_ROWS=0

# Postgres (used by Docker Compose)
POSTGRES_DB=webhooks_ingest
POSTGRES_USER=postgres
POSTGRES_PASSWORD=DemoPostgresAdmin!2025ChangeMe

# API DB user (created automatically on first DB init)
API_DB_USER=api_writer
API_DB_PASSWORD=DemoApiWriter!2025ChangeMe

# Metabase read-only DB user (created automatically on first DB init)
METABASE_READER_USER=metabase_reader
METABASE_READER_PASSWORD=DemoMetabaseReader!2025ChangeMe

# Metabase bootstrap (creates admin + DB connection on first run)
METABASE_SITE_NAME=Webhook Ingest Demo
METABASE_ADMIN_EMAIL=demo@example.com
METABASE_ADMIN_PASSWORD=DemoAdmin!2025ChangeMe

# Docker Compose host port bindings (avoid collisions)
API_BIND_IP=127.0.0.1
API_HOST_PORT=8080
METABASE_BIND_IP=127.0.0.1
METABASE_HOST_PORT=3001
POSTGRES_BIND_IP=127.0.0.1
POSTGRES_HOST_PORT=15432

# Production reverse proxy (only when using `docker-compose.caddy.yml`)
ACME_EMAIL=
API_DOMAIN=
METABASE_DOMAIN=
METABASE_PUBLIC_DASHBOARD_UUID=

# smee relays (auto-generated by `make demo`)
SMEE_SOURCE_URL_CLASSIFIED_NOTIFICATION=
SMEE_SOURCE_URL_CLASSIFIEDS_EXPORT=

# Optional provider secrets (placeholders)
# STRIPE_WEBHOOK_SECRET=
# GITHUB_WEBHOOK_SECRET=
